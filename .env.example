APP_NAME=PulseEngine
APP_ENV=development
DEBUG=true
SECRET_KEY=dev_secret_key_change_in_production_0123456789abcdef
API_KEY_HEADER=X-API-Key

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pulseengine
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0
REDIS_LOCK_TTL_SECONDS=30

RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

WEBHOOK_SECRET=default_webhook_signing_secret_dev
WEBHOOK_MAX_RETRIES=3
